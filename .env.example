# =====================================================================
# LIGERBOT configuration — copy to `.env` and fill in your own values.
# NEVER commit the real .env. It is git-ignored by default.
# =====================================================================

# ------------------------------ MODE ----------------------------------
# dry_run — nothing fills. Orders are logged and discarded. Wiring check.
# paper   — realistic simulated fills (next-bar open, slippage, costs).
# live    — real orders. Requires the live guard to pass; see DESIGN.md Phase 5.
#
# Do NOT use dry_run as paper trading: it fills nothing, and the historical
# instant-fill behaviour overstated results by ~0.22R per trade.
TRADING_MODE=dry_run

# ----------------------- Kotak Neo credentials ------------------------
# Generate the consumer key/secret from the "Trade API" card in the Kotak
# Neo app or web portal. Everything below is required for the probe.
KOTAK_ENVIRONMENT=prod
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=

# TOTP: provide EITHER the base32 secret (preferred — pyotp generates codes
# automatically) OR leave it blank and paste a fresh 6-digit code into
# KOTAK_TOTP at login time.
KOTAK_TOTP_SECRET=
KOTAK_TOTP=

# ------------------------------ Redis ---------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
STREAM_MAXLEN=100000

# ---------------------------- InfluxDB --------------------------------
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=ligerbot
INFLUX_BUCKET=trading_logs

# ------------------------------- Bars ---------------------------------
# Store 1-minute, trade 5-minute (DESIGN.md D4). 1-minute ATR stops are
# structurally uneconomic — see the economic stop floor in DESIGN.md §4.
BAR_INTERVAL_SECONDS=60
STRATEGY_BAR_SECONDS=300
BAR_VOLUME_MODE=cumulative
BAR_STORE_ROOT=bar_data

# ----------------------------- Strategy -------------------------------
# "sma_crossover" is the NEGATIVE CONTROL and loses money by design.
# Never point this at it for real trading.
STRATEGY_NAME=trend_pullback

# ------------------- Risk management (DESIGN.md D2) -------------------
# These four are internally consistent and validated at startup:
#   risk_per_trade x max_open_positions  <=  max_open_risk  <  max_daily_drawdown
# Changing one without the others will fail fast rather than trade wrongly.
MAX_DAILY_DRAWDOWN=0.02      # halt for the day after losing 2% of session equity
MAX_OPEN_RISK=0.015          # 1.5% — the PRIMARY cap (sum of distance-to-stop)
RISK_PER_TRADE=0.005         # 0.5% = 1.5% / 3
MAX_OPEN_POSITIONS=3         # secondary sanity cap only

# Concentration within a correlated group (sector, index ETFs). 0 disables.
MAX_POSITIONS_PER_GROUP=1

# Leverage guards, not risk guards. A tight stop implies a large notional for
# a fixed rupee risk; these bound exposure independently.
MAX_EXPOSURE_PER_TRADE=0.75
MAX_GROSS_EXPOSURE=2.0

# Long-only for v1 (DESIGN.md D3).
ALLOW_SHORT=false

# Equity is read from the broker each session, never configured. TOTAL_EQUITY
# is a simulation fallback only and is NOT valid for live trading.
TOTAL_EQUITY=500000
MIN_EQUITY=200000            # below this, costs exceed any plausible edge

# ----------------------- Execution settings ---------------------------
MAX_ORDERS_PER_SECOND=8      # client-side rate limit (broker allows ~10/s)
DEFAULT_PRODUCT=MIS          # MIS=intraday, CNC=delivery, NRML=F&O carry
DEFAULT_EXCHANGE_SEGMENT=nse_cm
MAX_SIGNAL_AGE_SECONDS=120   # refuse entries on signals older than this

# --------------------- Live trading (Phase 5) -------------------------
# Absolute backstops, live mode only. Every other limit is a fraction of
# equity — which is exactly wrong if the equity figure itself is wrong.
LIVE_MAX_DAILY_LOSS=5000
LIVE_MAX_ORDERS_PER_DAY=20
LIVE_MAX_LOSING_SESSIONS=3

# --------------------------- Instruments ------------------------------
# Comma-separated "token:name:segment".
#
# WARNING: the Nifty 50 INDEX (token 11536) is NOT tradable in the cash
# segment and is rejected at startup. Use liquid cash equities, or an ETF
# such as NIFTYBEES for index exposure. Tokens come from the scrip master.
INSTRUMENTS=

# NSE holidays move with the lunar calendar and the built-in list is
# PROVISIONAL. Point this at a verified JSON list of "YYYY-MM-DD" strings.
NSE_HOLIDAYS_FILE=
